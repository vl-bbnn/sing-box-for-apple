{
  "name": "WLT cellular RU and EU acceptance",
  "continue_on_failure": true,
  "host_preflight": {
    "uninstall_apps": ["com.dnateam.deepApp.dev"]
  },
  "apps": {
    "safari": "com.apple.mobilesafari",
    "springboard": "com.apple.springboard",
    "youtube": "com.google.ios.youtube",
    "twitch": "tv.twitch",
    "appstore": "com.apple.AppStore",
    "testflight": "com.apple.TestFlight",
    "deep_test": "com.dnateam.deepApp.dev",
    "chat": "pro.2b2n.chat",
    "steam": "com.valvesoftware.Steam",
    "playstation": "com.playstation.eu.playstationadhoc",
    "music": "com.apple.Music",
    "mattermost": "com.mattermost.rn",
    "hatimaki": "com.ionicframework.hatimaki",
    "tradingview": "com.tradingview.tradingviewapp",
    "smclinic": "ru.smclinic.app.lk",
    "maps": "com.google.Maps",
    "telegram": "ph.telegra.Telegraph",
    "whatsapp": "net.whatsapp.WhatsApp",
    "tiktok": "com.zhiliaoapp.musically",
    "instagram": "com.burbn.instagram",
    "twitter": "com.atebits.Tweetie2",
    "linkedin": "com.linkedin.LinkedIn"
  },
  "cleanup_steps": [
    { "action": "select_outbound", "app": "vpn", "group": "whitelist-exit", "outbound": "ru", "timeout": 30 },
    { "action": "terminate", "app": "youtube" },
    { "action": "terminate", "app": "twitch" },
    { "action": "terminate", "app": "testflight" },
    { "action": "terminate", "app": "deep_test" }
  ],
  "steps": [
    { "action": "launch", "app": "vpn", "timeout": 30, "fatal": true },
    { "action": "wait_any", "app": "vpn", "identifiers": ["wlt.profile.selector"], "timeout": 30, "fatal": true },
    { "action": "assert_text", "app": "vpn", "text": "WLT-clean", "timeout": 10, "fatal": true },
    { "action": "tap_if_text", "app": "vpn", "text": "Started", "identifier": "wlt.connection.toggle", "timeout": 10, "fatal": true },
    { "action": "assert_text", "app": "vpn", "text": "Stopped", "timeout": 30, "fatal": true },
    { "action": "tap_any", "app": "vpn", "identifiers": ["wlt.profile.refresh"], "timeout": 10, "fatal": true },
    { "action": "wait", "seconds": 5 },
    { "action": "disable_wifi", "app": "springboard", "timeout": 30, "fatal": true },
    { "action": "wait", "seconds": 15 },
    { "action": "activate", "app": "vpn", "timeout": 20, "fatal": true },
    { "action": "wait_any", "app": "vpn", "identifiers": ["wlt.profile.selector"], "timeout": 15, "fatal": true },
    { "action": "wait", "seconds": 3 },
    { "action": "tap_any", "app": "vpn", "identifiers": ["wlt.connection.toggle"], "timeout": 10, "fatal": true },
    { "action": "assert_text", "app": "vpn", "text": "Started", "timeout": 120, "fatal": true },
    { "action": "select_outbound", "app": "vpn", "group": "whitelist-exit", "outbound": "ru", "timeout": 30, "fatal": true },
    { "action": "screenshot", "name": "vpn-started-ru-lte" },

    { "action": "launch", "app": "testflight", "section": "deep-test-reinstall", "timeout": 30 },
    { "action": "testflight_install", "app": "testflight", "section": "deep-test-reinstall", "name": "deep-test-reinstall", "text": "deep test", "timeout": 240 },
    { "action": "screenshot", "section": "deep-test-reinstall", "name": "ru-testflight-deep-test-installed" },
    { "action": "launch", "app": "deep_test", "section": "deep-test-reinstall", "timeout": 60 },
    { "action": "wait", "section": "deep-test-reinstall", "seconds": 10 },
    { "action": "screenshot", "section": "deep-test-reinstall", "name": "ru-deep-test-launched" },

    { "action": "launch", "app": "safari", "timeout": 30 },
    { "action": "dismiss_pip", "app": "springboard", "timeout": 5 },
    { "action": "tap_if_any", "app": "safari", "identifiers": ["DoneButton"], "timeout": 2 },
    { "action": "type_into_any", "app": "safari", "identifiers": ["TabBarItemTitle"], "text": "https://rozetked.me\n", "timeout": 10 },
    { "action": "wait", "seconds": 5 },
    { "action": "assert_web_loaded", "app": "safari", "name": "rozetked", "expected_texts": ["Последние новости", "Статьи", "Новости"], "timeout": 20 },
    { "action": "screenshot", "name": "ru-safari-rozetked" },
    { "action": "type_into_any", "app": "safari", "identifiers": ["TabBarItemTitle"], "text": "https://zol.ru\n", "timeout": 10 },
    { "action": "wait", "seconds": 5 },
    { "action": "assert_web_loaded", "app": "safari", "name": "zol", "minimum_elements": 8, "timeout": 20 },
    { "action": "screenshot", "name": "ru-safari-zol" },
    { "action": "type_into_any", "app": "safari", "identifiers": ["TabBarItemTitle"], "text": "https://google.com\n", "timeout": 10 },
    { "action": "wait", "seconds": 5 },
    { "action": "assert_web_loaded", "app": "safari", "name": "google", "expected_texts": ["Поиск", "Search", "Мне повезёт", "I'm Feeling Lucky"], "timeout": 20 },
    { "action": "screenshot", "name": "ru-safari-google" },
    { "action": "type_into_any", "app": "safari", "identifiers": ["TabBarItemTitle"], "text": "https://tbank.ru\n", "timeout": 10 },
    { "action": "wait", "seconds": 5 },
    { "action": "assert_web_loaded", "app": "safari", "name": "tbank", "expected_texts": ["Т-Банк", "Войти", "Личный кабинет"], "timeout": 20 },
    { "action": "screenshot", "name": "ru-safari-tbank" },

    { "action": "launch", "app": "appstore", "timeout": 30 },
    { "action": "assert_app_ready", "app": "appstore", "name": "appstore", "identifiers": ["AppStore.today"], "failure_texts": ["Не удается подключиться", "Cannot Connect", "Не удалось загрузить", "Unable to Load"], "loading_texts": ["Загрузка…", "Loading…"], "timeout": 30 },
    { "action": "screenshot", "name": "ru-appstore" },
    { "action": "launch", "app": "chat", "timeout": 30 },
    { "action": "assert_app_ready", "app": "chat", "name": "2b2n-chat", "identifiers": ["home_screen-start_chat"], "failure_texts": ["Нет подключения", "Не удалось загрузить", "Network error", "Something went wrong"], "timeout": 30 },
    { "action": "screenshot", "name": "ru-2b2n-chat" },
    { "action": "launch", "app": "steam", "timeout": 30 },
    { "action": "assert_app_ready", "app": "steam", "name": "steam", "contains_texts": ["Featured & Recommended", "Discounts & Events"], "failure_texts": ["Нет подключения", "Не удалось подключиться", "Connection Error", "Network error"], "timeout": 30 },
    { "action": "screenshot", "name": "ru-steam" },
    { "action": "launch", "app": "playstation", "timeout": 30 },
    { "action": "assert_app_ready", "app": "playstation", "name": "playstation", "identifiers": ["play-component"], "auth_texts": ["sign-in-title", "Добро пожаловать в PlayStation", "Welcome to PlayStation"], "failure_texts": ["Нет подключения", "Не удалось подключиться", "Something went wrong", "Network error"], "timeout": 30 },
    { "action": "screenshot", "name": "ru-playstation" },
    { "action": "launch", "app": "music", "timeout": 30 },
    { "action": "assert_app_ready", "app": "music", "name": "apple-music", "identifiers": ["Music.accountButton"], "contains_texts": ["Музыка", "Music"], "failure_texts": ["Не удается подключиться", "Cannot Connect", "Не удалось загрузить", "Unable to Load"], "timeout": 30 },
    { "action": "screenshot", "name": "ru-apple-music" },
    { "action": "launch", "app": "mattermost", "timeout": 30 },
    { "action": "assert_app_ready", "app": "mattermost", "name": "mattermost", "identifiers": ["channel_list.screen"], "failure_texts": ["Нет подключения", "Не удалось подключиться", "Network request failed", "Unable to connect"], "timeout": 30 },
    { "action": "screenshot", "name": "ru-mattermost" },
    { "action": "launch", "app": "hatimaki", "timeout": 30 },
    { "action": "wait", "seconds": 15 },
    { "action": "assert_no_failure_text", "app": "hatimaki", "name": "hatimaki", "failure_texts": ["Нет подключения", "Нет соединения", "Не удалось загрузить", "Network error"] },
    { "action": "screenshot", "name": "ru-hatimaki" },
    { "action": "launch", "app": "tradingview", "timeout": 30 },
    { "action": "assert_app_ready", "app": "tradingview", "name": "tradingview", "identifiers": ["Watchlist.tableView"], "failure_texts": ["Нет подключения", "Не удалось подключиться", "Network error", "Connection error"], "timeout": 30 },
    { "action": "screenshot", "name": "ru-tradingview" },
    { "action": "launch", "app": "smclinic", "timeout": 30 },
    { "action": "wait", "seconds": 15 },
    { "action": "assert_no_failure_text", "app": "smclinic", "name": "smclinic", "failure_texts": ["Нет подключения", "Нет соединения", "Не удалось загрузить", "Network error"] },
    { "action": "screenshot", "name": "ru-smclinic" },
    { "action": "launch", "app": "maps", "timeout": 30 },
    { "action": "assert_app_ready", "app": "maps", "name": "google-maps", "identifiers": ["SearchHeaderSearchTxtView"], "failure_texts": ["Нет подключения", "Не удалось подключиться", "Offline", "Network error"], "timeout": 30 },
    { "action": "screenshot", "name": "ru-google-maps" },

    { "action": "launch", "app": "youtube", "timeout": 30 },
    { "action": "tap_if_any", "app": "youtube", "section": "youtube", "identifiers": ["id.ui.pivotbar.FEwhat_to_watch.button"], "timeout": 5 },
    { "action": "tap_any", "app": "youtube", "section": "youtube", "identifiers": ["id.ui.navigation.search.button"], "timeout": 20 },
    { "action": "type_into_any", "app": "youtube", "section": "youtube", "identifiers": ["id.navigation.search.text_field"], "text": "4K 60 fps HDR\n", "timeout": 10 },
    { "action": "assert_app_ready", "app": "youtube", "name": "youtube-search", "section": "youtube", "identifiers": ["eml.vwc"], "failure_texts": ["Произошла ошибка", "Нет подключения", "You’re offline", "Something went wrong"], "loading_texts": ["Действие выполняется", "Loading"], "timeout": 30 },
    { "action": "tap_any", "app": "youtube", "section": "youtube", "identifiers": ["eml.vwc"], "timeout": 5 },
    { "action": "wait_any", "app": "youtube", "section": "youtube", "identifiers": ["id.player"], "timeout": 30 },
    { "action": "wait", "section": "youtube", "seconds": 10 },
    { "action": "youtube_quality", "app": "youtube", "section": "youtube", "preferred_values": ["1080p60 HDR", "1080p60", "720p60 HDR", "720p60"], "timeout": 25 },
    { "action": "assert_value_changes", "app": "youtube", "section": "youtube", "identifiers": ["id.player.scrubber.slider"], "seconds": 30, "timeout": 10 },
    { "action": "assert_text_absent", "app": "youtube", "section": "youtube", "text": "Произошла ошибка", "timeout": 1 },
    { "action": "screenshot", "name": "ru-youtube-1080p60-or-720p60-hdr" },

    { "action": "launch", "app": "twitch", "timeout": 30 },
    { "action": "dismiss_pip", "app": "springboard", "timeout": 5 },
    { "action": "assert_app_ready", "app": "twitch", "name": "twitch-feed", "section": "twitch", "identifiers": ["tab_feed_tab_live_button"], "failure_texts": ["Бу! У вас в ленте призрак!", "Ошибка загрузки ленты", "Перезагрузите, пока не стало жутко!", "Произошла ошибка. Повторите попытку."], "loading_identifiers": ["circle_loading_indicator"], "timeout": 10 },
    { "action": "tap_any", "app": "twitch", "section": "twitch", "identifiers": ["Explore"], "timeout": 10 },
    { "action": "tap_any", "app": "twitch", "section": "twitch", "identifiers": ["category_Общение"], "timeout": 15 },
    { "action": "tap_any", "app": "twitch", "section": "twitch", "identifiers": ["sort_filter_button"], "timeout": 10 },
    { "action": "tap_any", "app": "twitch", "section": "twitch", "labels": ["Аудитория (по убыв.)"], "timeout": 10 },
    { "action": "wait", "section": "twitch", "seconds": 3 },
    { "action": "tap_twitch_live", "app": "twitch", "section": "twitch", "timeout": 15 },
    { "action": "assert_app_ready", "app": "twitch", "name": "twitch-live-player", "section": "twitch", "identifiers": ["video_player", "video_layer_view"], "failure_texts": ["Произошла ошибка. Повторите попытку.", "Ошибка воспроизведения", "Playback error"], "loading_identifiers": ["circle_loading_indicator"], "timeout": 60 },
    { "action": "twitch_quality", "app": "twitch", "section": "twitch", "text": "disable_low_latency", "identifiers": ["cell_720p60", "cell_960p60 (source)", "cell_1080p60 (source)", "cell_720p60 (source)"], "timeout": 20 },
    { "action": "assert_screen_changes", "app": "twitch", "section": "twitch", "name": "twitch-live-motion", "seconds": 15 },
    { "action": "assert_text_absent", "app": "twitch", "section": "twitch", "text": "Произошла ошибка. Повторите попытку.", "timeout": 1 },
    { "action": "screenshot", "name": "ru-twitch-live-720p60" },
    { "action": "tap_any", "app": "twitch", "section": "twitch", "identifiers": ["content_info_view_name_label"], "timeout": 15 },
    { "action": "tap_any", "app": "twitch", "section": "twitch", "labels": ["Видео", "Videos"], "timeout": 20 },
    { "action": "tap_twitch_vod", "app": "twitch", "section": "twitch", "timeout": 30 },
    { "action": "wait_any", "app": "twitch", "section": "twitch", "identifiers": ["video_player", "video_layer_view"], "timeout": 30 },
    { "action": "assert_any_absent", "app": "twitch", "section": "twitch", "identifiers": ["indicator_dot_live"], "timeout": 3 },
    { "action": "twitch_quality", "app": "twitch", "section": "twitch", "text": "disable_low_latency", "identifiers": ["cell_720p60", "cell_960p60 (source)", "cell_1080p60 (source)", "cell_720p60 (source)"], "timeout": 20 },
    { "action": "assert_screen_changes", "app": "twitch", "section": "twitch", "name": "twitch-vod-motion", "seconds": 15 },
    { "action": "assert_text_absent", "app": "twitch", "section": "twitch", "text": "Произошла ошибка. Повторите попытку.", "timeout": 1 },
    { "action": "screenshot", "name": "ru-twitch-vod-720p60" },

    { "action": "select_outbound", "app": "vpn", "group": "whitelist-exit", "outbound": "eu", "timeout": 30, "fatal": true },
    { "action": "screenshot", "name": "vpn-selected-eu" },
    { "action": "launch", "app": "safari", "timeout": 30 },
    { "action": "type_into_any", "app": "safari", "identifiers": ["TabBarItemTitle"], "text": "https://rutracker.org\n", "timeout": 10 },
    { "action": "wait", "seconds": 5 },
    { "action": "assert_web_loaded", "app": "safari", "name": "rutracker", "expected_texts": ["Форум", "Вход", "Регистрация"], "timeout": 20 },
    { "action": "screenshot", "name": "eu-safari-rutracker" },
    { "action": "type_into_any", "app": "safari", "identifiers": ["TabBarItemTitle"], "text": "https://lostfilm.tv\n", "timeout": 10 },
    { "action": "wait", "seconds": 5 },
    { "action": "assert_web_loaded", "app": "safari", "name": "lostfilm", "expected_texts": ["Новинки", "Сериалы", "LostFilm"], "timeout": 20 },
    { "action": "screenshot", "name": "eu-safari-lostfilm" },

    { "action": "launch", "app": "telegram", "timeout": 30 },
    { "action": "assert_app_ready", "app": "telegram", "name": "telegram", "labels": ["Поиск"], "contains_texts": ["Чаты", "Chats"], "failure_texts": ["Подключение…", "Connecting…", "Нет подключения", "Updating…"], "timeout": 30 },
    { "action": "screenshot", "name": "eu-telegram" },
    { "action": "launch", "app": "whatsapp", "timeout": 30 },
    { "action": "wait", "seconds": 12 },
    { "action": "assert_no_failure_text", "app": "whatsapp", "name": "whatsapp", "failure_texts": ["Подключение…", "Connecting…", "Нет подключения", "No Internet Connection"] },
    { "action": "screenshot", "name": "eu-whatsapp" },
    { "action": "launch", "app": "tiktok", "timeout": 30 },
    { "action": "assert_app_ready", "app": "tiktok", "name": "tiktok", "identifiers": ["TTKFeedTableViewService", "feedLikeButton"], "failure_texts": ["Нет подключения", "No Internet Connection", "Не удалось загрузить", "Couldn't load"], "timeout": 30 },
    { "action": "wait", "seconds": 15 },
    { "action": "assert_screen_changes", "app": "tiktok", "name": "tiktok-playback", "seconds": 5 },
    { "action": "screenshot", "name": "eu-tiktok-video" },
    { "action": "launch", "app": "instagram", "timeout": 30 },
    { "action": "tap_any", "app": "instagram", "identifiers": ["reels-tab"], "timeout": 20 },
    { "action": "assert_app_ready", "app": "instagram", "name": "instagram", "identifiers": ["sundial-viewer-video-collection-view", "reels-viewer"], "failure_texts": ["Нет подключения к Интернету", "No Internet Connection", "Не удалось обновить ленту", "Couldn't refresh feed"], "timeout": 30 },
    { "action": "wait", "seconds": 15 },
    { "action": "assert_screen_changes", "app": "instagram", "name": "instagram-playback", "seconds": 5 },
    { "action": "screenshot", "name": "eu-instagram-reels" },
    { "action": "launch", "app": "twitter", "timeout": 30 },
    { "action": "tap_if_any", "app": "twitter", "identifiers": ["only_important_notifications_button"], "timeout": 2 },
    { "action": "assert_app_ready", "app": "twitter", "name": "twitter", "element_types": ["cell"], "failure_texts": ["Не удается получить твиты", "Cannot retrieve posts", "Something went wrong", "Нет подключения"], "timeout": 30 },
    { "action": "wait", "seconds": 10 },
    { "action": "screenshot", "name": "eu-twitter" },
    { "action": "launch", "app": "linkedin", "timeout": 30 },
    { "action": "assert_app_ready", "app": "linkedin", "name": "linkedin", "element_types": ["cell"], "failure_texts": ["Нет подключения", "No Internet Connection", "Не удалось загрузить", "Something went wrong"], "timeout": 30 },
    { "action": "wait", "seconds": 10 },
    { "action": "screenshot", "name": "eu-linkedin" }
  ]
}
